{
  "name": "pr-dex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "catch": "node scripts/catch.mjs",
    "gen:species-info": "node scripts/gen-species-info.mjs",
    "gen:seed": "node scripts/gen-species-info.mjs --seed-only",
    "simulate:arena": "node scripts/simulate-arena.mjs",
    "db:check": "node scripts/check-schema-sync.mjs && node scripts/check-local-db.mjs",
    "db:start": "node scripts/check-local-db.mjs && supabase start",
    "db:reset": "node scripts/check-local-db.mjs && supabase db reset",
    "db:stop": "supabase stop"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
